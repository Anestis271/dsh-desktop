{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/client",
    "outDir": "lib/types/client",
    "skipLibCheck": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.d.ts"]
}
